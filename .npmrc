# Windows + pnpm: the default isolated node_modules creates a symlink farm inside
# .pnpm/. When the store lives on another drive (C: store, D: project) that step can
# fail with ERR_PNPM_SYMLINK_FAILED / "Maximum call stack size exceeded".
# A hoisted layout avoids the symlink farm and works on every platform we support.
node-linker=hoisted

# Keep installs reproducible across machines.
strict-peer-dependencies=false
auto-install-peers=true
