{
  "name": "criteria-compiler",
  "private": true,
  "version": "0.1.0",
  "description": "Compile a lab's eligibility criteria into executable rules, then screen literature candidates with evidence hints instead of black-box verdicts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "bench": "node bench/run.mjs",
    "start": "node bench/start.mjs",
    "axes": "node bench/axis-yield.mjs",
    "bench:json": "node bench/run.mjs --json",
    "validate": "node bench/validate-pack.mjs",
    "build": "tsc -b packages/core packages/cli packages/mcp",
    "test": "node bench/validate-pack.mjs && node bench/lib/criteria.selftest.mjs && node bench/lib/history.selftest.mjs && vitest run",
    "typecheck": "tsc -b packages/core && pnpm -r typecheck",
    "refine": "node bench/refine.mjs",
    "ledger": "node bench/ledger.mjs",
    "try": "node bench/try.mjs",
    "why": "node bench/why.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
